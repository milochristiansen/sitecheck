# testing_ground/configs/multi.env
# Multi-outpost test — local + remote outpost.
SITECHECK_OUTPOST_BIN=./scoutpost
SITECHECK_OUTPOST_WORKERS=4
SITECHECK_DEFAULT_TIMEOUT=15
SITECHECK_OUTPOSTS_DIR=testing_ground/outposts
SITECHECK_RESOURCES_DIR=testing_ground/resources/passing
SITECHECK_DB_PATH=testing_ground/work/data/sitecheck.db
SITECHECK_TEMPLATES_DIR=templates
SITECHECK_OUTPUT_DIR=testing_ground/work/output
SITECHECK_STATIC_DIR=static
SITECHECK_SITE_TITLE="SiteCheck Test Multi-Outpost"
SITECHECK_RETENTION_DAYS=7
SITECHECK_GRAPH_WINDOWS=24
SITECHECK_NTFY_SERVER=
TEST_HTTP_PORT=19976
TEST_REMOTE_PORT=19977
